CODEGRAPH_VERSION=local
CODEGRAPH_PORT=8084

MYSQL_CODEGRAPH_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password
NEO4J_PASSWORD=replace-with-a-strong-password

# At least 32 random characters. Never commit the real value.
CODEGRAPH_MASTER_KEY=replace-with-a-long-random-secret

# Directory containing installed parser CLIs. Commands are resolved inside /opt/codegraph/parsers.
CODEGRAPH_PARSER_HOME=./parsers

# Keep this empty until the matching language package has been installed.
# Enable only the language(s) that exist under CODEGRAPH_PARSER_HOME, for example:
# CODEGRAPH_PARSER_PROCESS_LANGUAGES=java
# CODEGRAPH_PARSER_JAVA_COMMAND=/opt/codegraph/parsers/bin/parser-java --stdio-stream
# CODEGRAPH_PARSER_PROCESS_LANGUAGES=go
# CODEGRAPH_PARSER_GO_COMMAND=/opt/codegraph/parsers/bin/parser-go --stdio-stream
# CODEGRAPH_PARSER_GO_STREAMING=true
CODEGRAPH_PARSER_PROCESS_LANGUAGES=
