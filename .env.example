CODEGRAPH_VERSION=local
CODEGRAPH_PORT=8084

MYSQL_CODEGRAPH_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password
NEO4J_PASSWORD=replace-with-a-strong-password

# At least 32 random characters. Never commit the real value.
CODEGRAPH_MASTER_KEY=replace-with-a-long-random-secret

# Directory containing installed parser CLIs. Commands are resolved inside /opt/codegraph/parsers.
CODEGRAPH_PARSER_HOME=./parsers
CODEGRAPH_PARSER_PROCESS_LANGUAGES="java go javascript typescript python php kotlin swift"
CODEGRAPH_PARSER_JAVA_COMMAND=/opt/codegraph/parsers/bin/parser-java --stdio
CODEGRAPH_PARSER_GO_COMMAND=/opt/codegraph/parsers/bin/parser-go --stdio-stream
CODEGRAPH_PARSER_GO_STREAMING=true
CODEGRAPH_PARSER_JAVASCRIPT_COMMAND=/opt/codegraph/parsers/bin/parser-js --stdio
CODEGRAPH_PARSER_TYPESCRIPT_COMMAND=/opt/codegraph/parsers/bin/parser-js --stdio
CODEGRAPH_PARSER_PYTHON_COMMAND=/opt/codegraph/parsers/bin/parser-python --stdio
CODEGRAPH_PARSER_PHP_COMMAND=/opt/codegraph/parsers/bin/parser-php --stdio
CODEGRAPH_PARSER_KOTLIN_COMMAND=/opt/codegraph/parsers/bin/parser-kotlin --stdio
CODEGRAPH_PARSER_SWIFT_COMMAND=/opt/codegraph/parsers/bin/parser-swift --stdio
